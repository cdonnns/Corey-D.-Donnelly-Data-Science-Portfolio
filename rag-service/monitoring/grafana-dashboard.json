{
  "title": "RAG Service Overview",
  "timezone": "browser",
  "refresh": "10s",
  "panels": [
    {
      "title": "Request Rate by Status",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(rag_requests_total[5m])) by (status)",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "title": "p50 / p95 / p99 Request Latency",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "histogram_quantile(0.50, rate(rag_request_latency_seconds_bucket[5m]))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, rate(rag_request_latency_seconds_bucket[5m]))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, rate(rag_request_latency_seconds_bucket[5m]))", "legendFormat": "p99" }
      ]
    },
    {
      "title": "Retrieval vs Generation Latency",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.95, rate(rag_retrieval_latency_seconds_bucket[5m]))", "legendFormat": "retrieval p95" },
        { "expr": "histogram_quantile(0.95, rate(rag_generation_latency_seconds_bucket[5m]))", "legendFormat": "generation p95" }
      ]
    },
    {
      "title": "Token Usage Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "sum(rate(rag_tokens_total[5m])) by (type)", "legendFormat": "{{type}}" }
      ]
    },
    {
      "title": "Pod Count (from HPA)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 16 },
      "targets": [
        { "expr": "kube_deployment_status_replicas{deployment=\"rag-service\"}" }
      ]
    },
    {
      "title": "Error Rate (SLO: < 2%)",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 16 },
      "targets": [
        {
          "expr": "sum(rate(rag_requests_total{status=\"error\"}[5m])) / sum(rate(rag_requests_total[5m]))"
        }
      ],
      "fieldConfig": {
        "defaults": { "max": 0.1, "thresholds": { "steps": [
          { "color": "green", "value": 0 },
          { "color": "yellow", "value": 0.02 },
          { "color": "red", "value": 0.05 }
        ]}}
      }
    }
  ]
}
