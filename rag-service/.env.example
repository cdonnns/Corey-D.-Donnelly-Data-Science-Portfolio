# Copy to .env and fill in for local development.
# Never commit the real .env file (already in .gitignore).

RAG_ENVIRONMENT=dev
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_LLM_MODEL=gpt-4o-mini
RAG_VECTOR_DB_BACKEND=chroma
RAG_VECTOR_DB_URL=http://localhost:6333
RAG_VECTOR_INDEX_PATH=./data/index
RAG_MLFLOW_TRACKING_URI=http://localhost:5000

# Required only when RAG_MOCK_LLM is not "true"
OPENAI_API_KEY=

# Set to "true" to run/test without any API key or network calls
RAG_MOCK_LLM=true
